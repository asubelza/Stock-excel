{
  "name": "gestionstock",
  "version": "1.0.0",
  "description": "GestionStock - Inventory Management System",
  "private": true,
  "scripts": {
    "dev": "python -m http.server 8000",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:a11y": "cypress run --spec \"cypress/e2e/a11y-modal.cy.js\"",
    "test:modal-crud": "cypress run --spec \"cypress/e2e/modal-crud.cy.js\"",
    "lint": "echo \"No linter configured\"",
    "format": "echo \"No formatter configured\"",
    "vr:capture": "npx playwright test tests/visual-regression/vr-capture.spec.ts --reporter=line",
    "vr:update": "UPDATE_BASELINE=true npx playwright test tests/visual-regression/vr-capture.spec.ts --reporter=line",
    "vr:compare": "npx playwright test tests/visual-regression/vr-compare.spec.ts --reporter=line",
    "a11y:scan": "npx playwright test tests/a11y/a11y-scan.spec.ts --reporter=line",
    "a11y:baseline": "UPDATE_BASELINE=true npx playwright test tests/a11y/a11y-baseline.spec.ts --reporter=line"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "axe-core": "^4.8.4",
    "cypress-axe": "^1.5.0",
    "@playwright/test": "^1.47.0",
    "@axe-core/playwright": "^4.10.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}