  "modals": [
    {
      "name": "create-product-modal",
      "triggerPage": "/stock/",
      "triggerSelector": "[data-cy='create-product']",
      "modalSelector": ".c-modal",
      "description": "Create product modal"
    },
    {
      "name": "edit-product-modal",
      "triggerPage": "/stock/",
      "triggerSelector": "[data-cy='edit-product']",
      "modalSelector": ".c-modal",
      "description": "Edit product modal",
      "precondition": "createTestProduct"
    },
    {
      "name": "delete-product-modal",
      "triggerPage": "/stock/",
      "triggerSelector": "[data-cy='delete-product']",
      "modalSelector": ".c-modal",
      "description": "Confirm delete product modal",
      "precondition": "createTestProduct"
    },
    {
      "name": "create-supplier-modal",
      "triggerPage": "/stock/proveedores",
      "triggerSelector": "[data-cy='create-supplier']",
      "modalSelector": ".c-modal",
      "description": "Create supplier modal"
    },
    {
      "name": "edit-supplier-modal",
      "triggerPage": "/stock/proveedores",
      "triggerSelector": "[data-cy='edit-supplier']",
      "modalSelector": ".c-modal",
      "description": "Edit supplier modal",
      "precondition": "createTestSupplier"
    },
    {
      "name": "create-customer-modal",
      "triggerPage": "/stock/clientes",
      "triggerSelector": "[data-cy='create-customer']",
      "modalSelector": ".c-modal",
      "description": "Create customer modal"
    },
    {
      "name": "edit-customer-modal",
      "triggerPage": "/stock/clientes",
      "triggerSelector": "[data-cy='edit-customer']",
      "modalSelector": ".c-modal",
      "description": "Edit customer modal",
      "precondition": "createTestCustomer"
    },
    {
      "name": "alert-modal",
      "triggerPage": "/stock/",
      "triggerSelector": "[data-cy='alert-modal']",
      "modalSelector": ".c-modal",
      "description": "Alert/notification modal"
    }
  ],
  
  "legacyPages": [
    {
      "path": "/stock/",
      "name": "stock-legacy",
      "reason": "Fallback for non-design-system users"
    }
  ],
  
  "excludedFromA11y": [
    {
      "path": "/stock/importar_excel",
      "reason": "Complex file upload, known legacy issues"
    }
  ],
  
  "suppressionRules": [
    {
      "rule": "color-contrast",
      "pages": ["stock-list", "historico", "entrada-list", "salida-list"],
      "reason": "Data table row hover states have marginal contrast in compact mode",
      "impact": "minor",
      "expires": "2026-12-31"
    },
    {
      "rule": "region",
      "pages": ["*"],
      "reason": "Legacy layout structure without explicit landmarks",
      "impact": "moderate",
      "expires": "2026-12-31"
    },
    {
      "rule": "landmark-one-main",
      "pages": ["*"],
      "reason": "App layout uses role=main but not explicit <main> in all templates",
      "impact": "moderate",
      "expires": "2026-12-31"
    }
  ],
  
  "syncInstructions": {
    "whenToUpdate": [
      "New template migrated to new design system",
      "Template removed or renamed",
      "Modal added/removed",
      "Route changed"
    ],
    "updateProcess": [
      "1. Add/remove page from this config",
      "2. Update template `migrated` status",
      "3. Run `pnpm vr:update` to capture new baselines",
      "4. Run `UPDATE_BASELINE=true pnpm a11y:baseline` to update a11y baseline",
      "4. Commit config + baselines together"
    ]
  }
}